<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>osmmapper</artifactId>
  <name>osmmapper</name>
  <version>${revision}</version>
  <description>OSM Markers mapper</description>
  <packaging>jar</packaging>

  <parent>
    <groupId>kwee</groupId>
    <artifactId>aggregator</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
 
  <dependencies>
    <dependency>
      <groupId>kwee</groupId>
      <artifactId>library</artifactId>
      <version>${revision}</version>
    </dependency> 
    <dependency>
      <groupId>kwee.email.sender</groupId>
      <artifactId>emailsenderpro</artifactId>
      <version>${revision}</version>
    </dependency>
    
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>${org-apache-poi-poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${org-apache-poi-ooxml.version}</version>
    </dependency>
    
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${com.fasterxml.jackson.core.version}</version>
    </dependency>      
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-slf4j</artifactId>
      <version>${log4j-slf4j-impl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    
    <dependency>
      <groupId>org.openstreetmap.gui</groupId>
      <artifactId>jmapviewer</artifactId>
      <version>${org-openstreetmap-gui-jmapviewer.version}</version>
    </dependency>
    
    <!-- Apache PDFBox voor PDF generatie -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${org-apache-pdfbox-pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${com.github.librepdf.openpdf.version}</version>
    </dependency>

    <!-- Voor afbeelding verwerking -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>${com.twelvemonkeys.imageio.imageio-jpeg.version}</version>
    </dependency>    
  </dependencies>

  <!-- Bouw instructies -->
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>   

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>${maven.min.version}</version>
                </requireMavenVersion>
              </rules>
              <fail>false</fail>
            </configuration>
          </execution>
        </executions>
      </plugin> 

      <!-- Fat jar met alle dependencies, services-bestanden samengevoegd -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${org-apache-maven-shade-plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>jar-with-dependencies</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>kwee.osmmapper.main.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${maven-assembly-plugin.version}</version>
        <executions>
          <execution>
            <id>zip-programs</id>
            <phase>install</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/distribution.xml</descriptor>
              </descriptors>
              <finalName>Programs-archive</finalName>
              <appendAssemblyId>false</appendAssemblyId>
            </configuration>
          </execution>          
        </executions>
      </plugin>
      
      <!-- Distribute tools v -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
        <configuration>
          <delimiters>
            <delimiter>@</delimiter>
          </delimiters>
          <useDefaultDelimiters>false</useDefaultDelimiters>
        </configuration>
        <executions>
          <execution>
            <id>CopyToolsOsmMapper</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}\BuildTools</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>..\BuildTools</directory>
                  <includes>
                    <include>HelpChm.cmd</include>
                    <include>innosetup.cmd</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
              <encoding>${project.build.sourceEncoding}</encoding>
            </configuration>
          </execution>     
          <execution>
            <id>CopyToolsOsmmapper2</id>
            <phase>initialize</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>..\BuildTools</directory>
                  <includes>
                    <include>Library.iss</include>
                    <include>keystore.jks</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
              <encoding>${project.build.sourceEncoding}</encoding>
            </configuration>
          </execution>     
          <execution>
            <id>readme-md</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>.</directory>
                  <includes>
                    <include>readme.md</include>
                    <include>*.PNG</include>
                    <include>*.jpg</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
              <encoding>${project.build.sourceEncoding}</encoding>
            </configuration>
          </execution>
          <execution>
            <id>readme-md-usb</id>
            <phase>verify</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}\Programs</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>.</directory>
                  <includes>
                    <include>readme.md</include>
                    <include>*.PNG</include>
                    <include>*.jpg</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
              <encoding>${project.build.sourceEncoding}</encoding>
            </configuration>
          </execution>          
          <execution>
            <id>helpfile</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/help/en</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>${project.basedir}/help/en</directory>
                  <includes>
                    <include>osmmapper.chm</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution> 
          <execution>
            <id>helpfilenl</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/help/nl</outputDirectory>
              <resources>                                        
                <resource>
                  <directory>${project.basedir}/help/nl</directory>
                  <includes>
                    <include>osmmapper.chm</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>         
        </executions>
      </plugin>        

      <!-- LAUNCH4J create executable v -->
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId>
        <artifactId>launch4j-maven-plugin</artifactId>
        <version>${launch4j-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>l4j-clui</id>
            <phase>package</phase>
            <goals>
              <goal>launch4j</goal>
            </goals>
            <configuration>
              <headerType>console</headerType>
              <!-- BELANGRIJK: gebruik de fat jar, niet de dunne osmmapper.jar -->
              <jar>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</jar>
              <outfile>${project.build.directory}/osmmapper.exe</outfile>
              <downloadUrl>${downloadUrl.jre}</downloadUrl>
              <classPath>
                <mainClass>kwee.osmmapper.main.Main</mainClass>
              </classPath>
              <jre>
                <path>%java_home%</path>
              </jre>
              <icon>src/main/resources/OSMMapper.ico</icon>
              <versionInfo>
                <fileVersion>${project.version}</fileVersion>
                <txtFileVersion>${project.version}</txtFileVersion>
                <fileDescription>${project.name}</fileDescription>
                <copyright>C</copyright>
                <productVersion>${project.version}</productVersion>
                <txtProductVersion>${project.version}</txtProductVersion>
                <productName>${project.name}</productName>
                <internalName>osmmapper</internalName>
                <originalFilename>osmmapper.exe</originalFilename>
                <companyName>${companyName}</companyName>
              </versionInfo>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- LAUNCH4J ^ -->

      <!-- Sign executable v -->
      <plugin>
        <groupId>net.jsign</groupId>
        <artifactId>jsign-maven-plugin</artifactId>
        <version>${jsign-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>sign</id>
            <phase>package</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <file>${project.build.directory}/osmmapper.exe</file>
              <name>OSM Mapper</name>
              <url>https://github.com/RSHKwee/osmmapper</url>
              <keystore>keystore.jks</keystore>
              <alias>RSHK</alias>
              <storepass>${keystore.password}</storepass>
            </configuration>
          </execution>
          
          <execution>
            <id>sign_inst</id>
            <phase>install</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <file>${project.build.directory}/osmmapper_v${project.version}_setup.exe</file>
              <name>OSM Mapper</name>
              <url>https://github.com/RSHKwee/osmmapper</url>
              <keystore>keystore.jks</keystore>
              <alias>RSHK</alias>
              <storepass>${keystore.password}</storepass>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Onderteken de FAT jar, niet de dunne osmmapper.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jarsigner-plugin</artifactId>
        <version>${maven-jarsigner-plugin.version}</version>
        <executions>
          <execution>
            <id>sign</id>
            <phase>package</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <file>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</file>
              <keystore>keystore.jks</keystore>
              <alias>RSHK</alias>
              <storepass>${keystore.password}</storepass>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Sign executable ^ -->

      <!-- Windows installers v -->    
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>osmmapperHelpEn</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>          
            <configuration>
              <executable>BuildTools\HelpChm.cmd</executable>
              <workingDirectory>help/en</workingDirectory>
              <arguments>
                <argument>osmmapper.hhp</argument>
              </arguments>
            </configuration>          
          </execution>
          <execution>
            <id>osmmapperHelpNl</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>          
            <configuration>
              <executable>BuildTools\HelpChm.cmd</executable>
              <workingDirectory>help/nl</workingDirectory>
              <arguments>
                <argument>osmmapper.hhp</argument>
              </arguments>
            </configuration>          
          </execution>      
          <execution>
            <id>innoSetup</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>          
            <configuration>
              <executable>BuildTools\innosetup.cmd</executable>
              <workingDirectory>...</workingDirectory>
              <arguments>
                <argument>osmmapper.iss</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JPackage Plugin voor zelfstandige app op USB -->
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <version>${jpackage-maven-plugin.version}</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <overwrite>true</overwrite>
          <name>OSMMapper</name>
          <type>APP_IMAGE</type>
          <icon>src/main/resources/OSMMapper.ico</icon>
          <input>${project.build.directory}</input>
          <!-- Gebruik de fat jar -->
          <mainJar>${project.artifactId}-${project.version}-jar-with-dependencies.jar</mainJar>
          <destination>${project.build.directory}/Programs</destination>
          <appVersion>${project.version}</appVersion>
          <vendor>RSH Kwee</vendor>
          <copyright>${project.copyright.text}</copyright>
          <description>Excel Markers in OSM</description>                          
        </configuration>
      </plugin>
      
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <!-- Het uiteindelijke JAR-pad dat Maven berekent, direct doorgeven -->
            <built.jar.path>${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</built.jar.path>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      
      <!-- Opruimen -->      
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-pluginversion}</version>
        <executions>
          <execution>
            <id>cleaninstall</id>
            <phase>install</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${project.basedir}\BuildTools"/>
                <delete file="${project.basedir}\Library.iss"/>   
                <delete file="${project.basedir}\keystore.jks"/>   
                <delete file="${project.build.directory}\Programs\OSMMapper\app\osmmapper.exe"/>
                <delete file="${project.build.directory}\Programs\OSMMapper\app\osmmapper_v${project.version}_setup.exe"/>
                <delete file="${project.build.directory}\Programs\OSMMapper\app\osmmapper-${project.version}.jar"/>
                <delete dir="${project.build.directory}\Programs\OSMMapper\app\USB"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>clean-zip</id>
            <phase>install</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <unzip src="${project.build.directory}/Programs-archive.zip"
                       dest="${project.build.directory}/zip-temp/usb"/>
                <delete file="${project.build.directory}/zip-temp/usb/OSMMapper/app/OSMMapper.exe"/>
                <delete file="${project.build.directory}/zip-temp/usb/OSMMapper/app/OSMMapper_v${project.version}_setup.exe"/>
                <delete file="${project.build.directory}/zip-temp/usb/OSMMapper/app/OSMMapper-${project.version}.jar"/>
                <delete dir="${project.build.directory}/zip-temp/usb/OSMMapper/app/Programs"/>
                <zip destfile="${project.build.directory}/OSMMapperStandalone-${project.version}.zip"
                     basedir="${project.build.directory}/zip-temp"/>
                <delete dir="${project.build.directory}/zip-temp"/>
                <delete file="${project.build.directory}/Programs-archive.zip"/>                 
              </target>
            </configuration>
          </execution>        
        </executions>
      </plugin>  
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/RSHKwee/osmmapper</url>
    </repository>
  </distributionManagement>
</project>